# Copy this file to .env. `make dev` creates .env automatically when it is missing.
# The starter boots without any of the optional values below.

# Browser-facing API origin during development.
# Leave this as localhost for `make dev`.
# `make dev-wifi` overrides it for the running process so other devices can call the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API directly.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# development | production. The Compose files set this for containers.
APP_ENV=development

# Optional. The starter does not connect to a database.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@host:5432/postgres

# Supabase Auth. The backend calls Auth with the publishable key and verifies
# access tokens locally. Leave both empty to boot without authentication.
# Do not put a secret or service-role key in this file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
